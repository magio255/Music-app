options:
    prefix: "&a&lRin &7&l>>"

on load:
    delete {backloc::*}

on first join:
    wait 20 ticks
    set the player's gamemode to survival
    teleport player to {spawn}

on join:
    set the player's gamemode to survival
    player has permission "*"
    send "&aHello admin"

on player move:
    set {_p} to event-player
    if {ismove::%{_p}%} is not set:
        stop
    if {ismove::%{_p}%} is "false":
        if player's location is not {ismoveloc::%{_p}%}:
            set {ismove::%{_p}%} to "true"

on teleport:
    if player has permission "command.back":
        set {backloc::%player%} to teleport from

command repair [<string>]:
    permission: command.repair
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            send "%{@prefix}% &fHow to use /repair &a<hand,all>"
            stop
        if arg-1 is "hand":
            if player's tool is air:
                send "%{@prefix}% &fPlease hold the item you want to repair."
                stop
            repair player's tool
            send "%{@prefix}% &fRepaired the item in your hand."
            stop
        if arg-1 is "all":
            loop player's inventory:
                repair loop-value
            send "%{@prefix}% &fRepaired all of your items."
            stop

command tp [<player>] [<player>]:
    permission: command.tp
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            send "%{@prefix}% &cPlease specify the player you want to teleport to."
            stop
        if arg-2 is set:
            teleport arg-1 to arg-2
            send "%{@prefix}% &fTeleported player &a%arg-1% &fto &a%arg-2%"
            stop
        teleport player to arg-1
        send "%{@prefix}% &fTeleported to player &a%arg-1%"

command tptoggle [<player>]:
    permission: command.tptoggle
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            if {tptoggle::%player%} is not set:
                set {tptoggle::%player%} to true
                send "%{@prefix}% &fYou have &cdisabled &fother players from teleporting to you."
            else if {tptoggle::%player%} is false:
                set {tptoggle::%player%} to true
                send "%{@prefix}% &fYou have &cdisabled &fother players from teleporting to you."
            else if {tptoggle::%player%} is true:
                set {tptoggle::%player%} to false
                send "%{@prefix}% &fYou have &aenabled &fother players to teleport to you."
            stop
        if player doesn't have permission "*":
            send "%{@prefix}% &cYou don't have permission to use this command!"
            stop
        if {tptoggle::%arg-1%} is not set:
            set {tptoggle::%arg-1%} to true
            send "%{@prefix}% &fYou have &cdisabled &fteleporting for player &a%arg-1%"
        else if {tptoggle::%arg-1%} is false:
            set {tptoggle::%arg-1%} to true
            send "%{@prefix}% &fYou have &cdisabled &fteleporting for player &a%arg-1%"
        else if {tptoggle::%arg-1%} is true:
            set {tptoggle::%arg-1%} to false
            send "%{@prefix}% &fYou have &aenabled &fteleporting for player &a%arg-1%"

command iteminfo:
    permission: command.iteminfo
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    aliases: /read
    trigger:
        if player's tool is air:
            send "%{@prefix}% &cYou didn't hold anything in your hand!"
            stop
        send "&7&l============================"
        send "&adisplay_name: &f%name of player's tool%"
        send "&amaterial: &f%type of player's tool%"
        send "&amodel_data: &f%custom model data of player's tool%"
        send "&7&l============================"

command info [<player>]:
    permission: command.info
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            send "%{@prefix}% &aip: &f%ip of player%"
            send "%{@prefix}% &auuid: &f%uuid of player%"
            stop
        send "%{@prefix}% &aip: &f%ip of arg-1%"
        send "%{@prefix}% &auuid: &f%uuid of arg-1%"

command fly [<player>]:
    permission: command.fly
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            if player's flight mode is true:
                set player's flight mode to false
                send "%{@prefix}% &cDisabled &fFlight Mode"
            else:
                set player's flight mode to true
                send "%{@prefix}% &aEnabled &fFlight Mode"
            stop
        if arg-1's flight mode is true:
            set arg-1's flight mode to false
            send "%{@prefix}% &cDisabled &fFlight Mode for player &a%arg-1%"
            send "%{@prefix}% &fYour flight mode has been &cdisabled &fby &a%player%" to arg-1
        else:
            set arg-1's flight mode to true
            send "%{@prefix}% &aEnabled &fFlight Mode for player &a%arg-1%"
            send "%{@prefix}% &fYour flight mode has been &aenabled &fby &a%player%" to arg-1

command back:
    permission: command.back
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if {backloc::%player%} is not set:
            send "%{@prefix}% &cNo such location saved."
            stop
        send "%{@prefix}% &fTeleported you back to your previous location."
        teleport player to {backloc::%player%}

command spawn:
    permission: command.spawn
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if {spawn} is not set:
            send "%{@prefix}% &cThe spawn point has not been set yet."
            stop
        send "%{@prefix}% &aTeleporting you to the spawn point."
        teleport player to {spawn}

command setspawn:
    permission: rin.admin
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        send "&aSet a new spawn point."
        set {spawn} to player's location

