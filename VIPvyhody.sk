command tpdeny:
    permission: command.tpdeny
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if {rintpa::%player%} is not set:
            send "%{@prefix}% &cYou do not have any pending teleport requests."
            stop
        set {_p} to {rintpa::%player%}
        delete {rintpa::%player%}
        send "%{@prefix}% &cYou have denied the request from &a%{_p}%"

command heal [<player>]:
    permission: command.heal
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            heal(player)
            send "%{@prefix}% &fYou have healed &ayourself &fand restored your hunger."
        else:
            heal(arg-1)
            send "%{@prefix}% &fYou have healed &a%arg-1% &fand restored their hunger."
            send "%{@prefix}% &a%player% &fhas healed you." to arg-1

command msg [<player>] [<string>]:
    permission: command.msg
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            send "%{@prefix}% &cPlease specify the player you want to message."
            stop
        if arg-2 is not set:
            send "%{@prefix}% &cPlease enter the message you want to send."
            stop
        send "%{@prefix}% &fYou have sent a message to &a%arg-1%"
        send "%{@prefix}% &a%player% &fhas sent you a message &7: &7%arg-2%" to arg-1

command sethome:
    permission: command.sethome
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    executable by: players
    trigger:
        set {homes::%uuid of player%} to location of player
        message "%{@prefix}% &fYou have set your home at &a%location of player%"

command delhome:
    permission: command.delhome
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    executable by: players
    trigger:
        clear {homes::%uuid of player%}
        message "%{@prefix}% &fYou have deleted your home."

command home:
    permission: command.home
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    executable by: players
    trigger:
        set {_p} to player
        if {homes::%uuid of player%} is not set:
            message "%{@prefix}% &cYou have not set a home yet!"
        else:
            set {ismove::%{_p}%} to "false"
            set {ismoveloc::%{_p}%} to {_p}'s location
            loop 3 times:
                if {ismove::%{_p}%} is "false":
                    send title "&6Cooldown" with subtitle "&fAnother &a%4 - loop-number% &fseconds until you teleport home." to player for 5 tick with fadeout 5 tick
                    play sound "entity.experience_orb.pickup" with volume 0.5 to the player
                    wait 1 second
                else:
                    send title "&cTeleport Canceled" with subtitle "&fTeleportation canceled due to movement." to player for 20 tick with fadeout 20 tick
                    play sound "entity.villager.no" with volume 0.5 to the player
                    delete {ismoveloc::%{_p}%}
                    delete {ismove::%{_p}%}
                    exit
            teleport player to {homes::%uuid of player%}

command inv [<player>]:
    permission: command.inv
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            send "%{@prefix}% &cYou must specify the player's name!"
            stop
        if arg-1 is player:
            send "%{@prefix}% &cYou don't need to open your own inventory."
            stop
        open inventory of arg-1 to player

command broadcast [<string>]:
    permission: command.broadcast
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            send "%{@prefix}% &cMissing argument!"
            stop
        broadcast colored arg-1

command hat [<player>]:
    permission: command.hat
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is set:
            if player doesn't have permission "*":
                send "%{@prefix}% &cYou cant use this command!"
                stop
            set {_head} to arg-1's helmet
            set {_i} to player's tool
            if {_i} is air:
                send "%{@prefix}% &cPlease hold the item you want to wear."
                stop
            if {_head} is not air:
                remove {_head} from arg-1's helmet
                add {_head} to player's inventory
                set helmet of arg-1 to {_i}
                remove {_i} from player's inventory
                send "%{@prefix}% &fYou have equipped a helmet for &a%arg-1%"
                stop
            set helmet of arg-1 to {_i}
            remove {_i} from player's inventory
            send "%{@prefix}% &fYou have equipped a helmet &a%arg-1%"
        else if arg-1 is not set:
            set {_head} to player's helmet
            set {_i} to player's tool
            if {_i} is air:
                send "%{@prefix}% &cPlease hold the item you want to wear."
                stop
            if {_head} is not air:
                remove {_head} from player's helmet
                add {_head} to player's inventory
                set helmet of player to {_i}
                remove {_i} from player's inventory
                send "%{@prefix}% &fYou have equipped a helmet."
                stop
            set helmet of player to {_i}
            remove {_i} from player's inventory
            send "%{@prefix}% &fYou have equipped a helmet."

command enderchest [<player>]:
    permission: command.enderchest
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            open the player's ender chest to the player
            send "%{@prefix}% &fYou are opening your own ender chest."
            stop
        open the ender chest of arg-1 for the player
        send "%{@prefix}% &fYou are opening the ender chest of &a%arg-1%"

command craft [<player>]:
    permission: command.craft
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            open crafting table for the player
            send "%{@prefix}% &fOpening a crafting table."
            stop
        open crafting table for arg-1
        send "%{@prefix}% &fOpening a crafting table for &a%arg-1%&f."

command smithingtable [<player>]:
    permission: command.smithingtable
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            open smithing inventory for the player
            send "%{@prefix}% &fOpening a smithing table."
            stop
        open smithing inventory for arg-1
        send "%{@prefix}% &fOpening a smithing table for &a%arg-1%&f."

command anvil [<player>]:
    permission: command.anvil
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            open anvil for the player
            send "%{@prefix}% &fOpening a anvil."
            stop
        open anvil for arg-1
        send "%{@prefix}% &fOpening a anvil for &a%arg-1%&f."

command stonecutter [<player>]:
    permission: command.stonecutter
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            open stonecutter inventory for the player
            send "%{@prefix}% &fOpening a stonecutter."
            stop
        open stonecutter inventory for arg-1
        send "%{@prefix}% &fOpening a stonecutter for &a%arg-1%&f."

command dispose [<player>]:
    permission: command.dispose
    permission message: {@prefix} &cYou cannot use this command. If you believe there's an issue, please contact an admin or system administrator.
    trigger:
        if arg-1 is not set:
            open chest inventory with 4 rows named "&cDisposal" to player
            send "%{@prefix}% &fOpening a disposal."
            stop
        open chest inventory with 4 rows named "&cDisposal" to arg-1
        send "%{@prefix}% &fOpening a disposal for &a%arg-1%&f."

function heal(p : player):
    heal {_p}
    set food level of {_p} to 20
    set saturation of {_p} to 20