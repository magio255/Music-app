# ==========================================
#             ᴄʟɪᴄᴋᴇʀ ᴍᴏʙ sᴋʀɪᴘᴛ
# ==========================================

options:
    prefix: &6&lᴄʟɪᴄᴋᴇʀ &8»&f
    mob_name: &e&lᴄʟɪᴄᴋᴇʀ ᴍᴏʙ
    reward_money: 1000

    # Šance na odměny (v procentech)
    chance_iron: 10
    chance_gold: 5
    chance_diamond: 2
    chance_key: 0.5

variables:
    {clicker::total_clicks} = 0

# --- POMOCNÉ FUNKCE ---

function cacheEntities():
    delete {-clicker::session::*}
    if {clicker::location} is set:
        loop all entities in radius 10 around {clicker::location}:
            set {_tags::*} to scoreboard tags of loop-entity
            if {_tags::*} contains "clicker_mob":
                set {-clicker::session::mob} to loop-entity
            else if {_tags::*} contains "clicker_h1":
                set {-clicker::session::h1} to loop-entity
            else if {_tags::*} contains "clicker_h2":
                set {-clicker::session::h2} to loop-entity
            else if {_tags::*} contains "clicker_h3":
                set {-clicker::session::h3} to loop-entity
            else if {_tags::*} contains "clicker_h4":
                set {-clicker::session::h4} to loop-entity
            else if {_tags::*} contains "clicker_h5":
                set {-clicker::session::h5} to loop-entity

# --- PŘÍKAZY ---

command /clicker [<text>] [<text>]:
    permission: clicker.admin
    permission message: &c&lᴄʜʏʙᴀ &8| &fɴᴇᴍás ᴘʀáᴠᴏ!
    trigger:
        if arg-1 is not set:
            send " "
            send "{@prefix} &e&lɴáᴘᴏᴠěᴅᴀ"
            send " &8• &f/clicker spawn &7- ᴠʏᴛᴠᴏří ᴍᴏʙᴀ"
            send " &8• &f/clicker delete &7- sᴍᴀžᴇ ᴍᴏʙᴀ ᴀ ʜᴏʟᴏɢʀᴀᴍʏ"
            send " &8• &f/clicker move &7- ᴘřᴇsᴜɴᴇ ᴍᴏʙᴀ ᴋ ᴛᴏʙě"
            send " &8• &f/clicker settype <entity> &7- ᴢᴍěɴí ᴛʏᴘ ᴍᴏʙᴀ"
            send " &8• &f/clicker debug &7- sᴛᴀᴠ ᴇɴᴛɪᴛ"
            send " "
            stop

        if arg-1 is "spawn":
            if {clicker::location} is set:
                send "{@prefix} &cᴍᴏʙ ᴊɪž ᴇxɪsᴛᴜᴊᴇ! &7(/clicker delete pro smazání)"
                stop

            set {clicker::location} to player's location

            set {_t_str} to {clicker::type_str}
            if {_t_str} is not set:
                set {_t_str} to "skeleton"

            # --- SPAWN ---
            # Zkusíme nejdříve nativní Skript spawn
            set {_t} to {_t_str} parsed as entity type
            if {_t} is set:
                spawn {_t} at {clicker::location}
            else:
                # Fallback na skeletona pokud parsování selže
                spawn skeleton at {clicker::location}

            set {_m} to last spawned entity
            if {_m} is not set:
                # Pokud pořád nic, zkusíme Minecraft příkaz
                set {_x} to x-coordinate of player
                set {_y} to y-coordinate of player
                set {_z} to z-coordinate of player
                set {_w} to name of world of player
                execute console command "minecraft:execute in %{_w}% run minecraft:summon %{_t_str}% %{_x}% %{_y}% %{_z}% {Tags:[""clicker_mob""]}"
                wait 2 ticks
                loop all entities in radius 2 around player:
                    if scoreboard tags of loop-entity contains "clicker_mob":
                        set {_m} to loop-entity
                        stop loop

            if {_m} is not set:
                send "{@prefix} &cᴄʜʏʙᴀ: ᴍᴏʙ sᴇ ɴᴇsᴘᴀᴡɴᴏᴠᴀʟ! &7(Zkontroluj ochranu území / spawn protection)"
                delete {clicker::location}
                stop

            set custom name of {_m} to "{@mob_name}"
            execute console command "tag %uuid of {_m}% add clicker_mob"
            execute console command "data merge entity %uuid of {_m}% {Invulnerable:1b,NoAI:1b,PersistenceRequired:1b,CustomNameVisible:1b}"

            # Hologramy
            set {_loc} to {clicker::location}
            set y-coord of {_loc} to y-coord of {_loc} + 3.0

            loop 5 times:
                spawn armor stand at {_loc}
                set {_h} to last spawned entity
                set custom name of {_h} to "&r" # Schová "Armor Stand"
                execute console command "tag %uuid of {_h}% add clicker_h%loop-number%"
                execute console command "data merge entity %uuid of {_h}% {Invisible:1b,Marker:1b,NoGravity:1b,CustomNameVisible:1b}"

                if loop-number is 4:
                    set y-coord of {_loc} to y-coord of {_loc} - 0.6
                else:
                    set y-coord of {_loc} to y-coord of {_loc} - 0.3

            wait 5 ticks
            cacheEntities()
            updateHolograms()
            send "{@prefix} &aᴍᴏʙ ʙʏʟ úspěšɴě ᴠʏᴛᴠᴏřᴇɴ!"

        if arg-1 is "debug":
            send "{@prefix} &eᴅᴇʙᴜɢ:"
            send " &8• &fʟᴏᴋᴀᴄᴇ: &7%{clicker::location}%"
            send " &8• &fᴍᴏʙ ᴠ ᴄᴀᴄʜᴇ: &7%{-clicker::session::mob}%"
            send " &8• &fʜ1 ᴠ ᴄᴀᴄʜᴇ: &7%{-clicker::session::h1}%"
            loop all entities in radius 10 around player:
                send " &8• &f%loop-entity% &7(Tags: %scoreboard tags of loop-entity%)"

        if arg-1 is "delete":
            loop all entities in radius 15 around {clicker::location}:
                set {_tags::*} to scoreboard tags of loop-entity
                if "%{_tags::*}%" contains "clicker_":
                    kill loop-entity
            delete {clicker::location}
            delete {-clicker::session::*}
            send "{@prefix} &cᴍᴏʙ ᴀ ʜᴏʟᴏɢʀᴀᴍʏ ʙʏʟʏ sᴍᴀᴢáɴʏ!"

        if arg-1 is "move":
            if {clicker::location} is not set:
                send "{@prefix} &cᴍᴏʙ ɴᴇᴇxɪsᴛᴜᴊᴇ!"
                stop

            set {_old} to {clicker::location}
            set {clicker::location} to location of player

            loop all entities in radius 15 around {_old}:
                set {_tags::*} to scoreboard tags of loop-entity
                if {_tags::*} contains "clicker_mob":
                    teleport loop-entity to {clicker::location}

            set {_l} to {clicker::location}
            set y-coord of {_l} to y-coord of {_l} + 3.0
            loop 5 times:
                set {_tag} to "clicker_h%loop-number%"
                loop all entities in radius 15 around {_old}:
                    set {_tags2::*} to scoreboard tags of loop-entity
                    if {_tags2::*} contains {_tag}:
                        teleport loop-entity to {_l}
                if loop-number is 4:
                    set y-coord of {_l} to y-coord of {_l} - 0.6
                else:
                    set y-coord of {_l} to y-coord of {_l} - 0.3

            cacheEntities()
            send "{@prefix} &aᴍᴏʙ ᴀ ʜᴏʟᴏɢʀᴀᴍʏ ʙʏʟʏ ᴘřᴇsᴜɴᴜᴛʏ!"

        if arg-1 is "settype":
            set {clicker::type_str} to arg-2
            if {clicker::location} is set:
                execute player command "clicker delete"
                wait 10 ticks
                execute player command "clicker spawn"
            send "{@prefix} &aᴛʏᴘ ᴍᴏʙᴀ ɴᴀsᴛᴀᴠᴇɴ!"

# --- LOGIKA ---

on damage:
    if scoreboard tags of victim contains "clicker_mob":
        cancel event
        clickLogic(attacker)

on right click on entity:
    if scoreboard tags of entity contains "clicker_mob":
        cancel event
        clickLogic(player)

function clickLogic(p: player):
    add 1 to {clicker::player_clicks::%uuid of {_p}%}
    add 1 to {clicker::total_clicks}

    execute console command "/money give %{_p}% {@reward_money}"

    set {_rnd} to random number between 0 and 100
    if {_rnd} <= {@chance_key}:
        execute console command "/crate key give %{_p}% vote_klic 1"
        send "{@prefix} &6&lɢɢ! &fᴢísᴋᴀʟ ᴊsɪ &e&lᴠᴏᴛᴇ ᴋʟíč&f!" to {_p}
    else if {_rnd} <= ({@chance_key} + {@chance_diamond}):
        give 1 diamond to {_p}
    else if {_rnd} <= ({@chance_key} + {@chance_diamond} + {@chance_gold}):
        give 1 gold ingot to {_p}
    else if {_rnd} <= ({@chance_key} + {@chance_diamond} + {@chance_gold} + {@chance_iron}):
        give 1 iron ingot to {_p}

    set {_v} to vector between {clicker::location} and {_p}
    if vector length of {_v} is 0:
        set {_v} to vector(random number between -1 and 1, 0, random number between -1 and 1)
    set vector length of {_v} to 0.5
    set y of {_v} to 0.2
    push {_p} {_v} at speed 0.8
    updateHolograms()

function updateHolograms():
    set {_diff} to difference between {clicker::last_update} and now
    if {_diff} is less than 2 seconds:
        stop
    set {clicker::last_update} to now
    if {-clicker::session::h1} is not alive:
        cacheEntities()

    set {_top::*} to sorted indices of {clicker::player_clicks::*} in descending order
    set custom name of {-clicker::session::h1} to "&6&lᴛᴏᴘ 3 ᴄʟɪᴄᴋᴇʀɪ"
    loop 3 times:
        set {_u} to {_top::%loop-number%}
        set {_h} to {-clicker::session::h%loop-number + 1%}
        if {_u} is set:
            set {_name} to {_u} parsed as offline player
            set custom name of {_h} to "&e%loop-number%. &f%{_name}% &7- &e%{clicker::player_clicks::%{_u}%}%"
        else:
            set custom name of {_h} to "&8%loop-number%. ..."
    set custom name of {-clicker::session::h5} to "&e&lᴍᴏžɴé ᴏᴅᴍěɴʏ &7($1000, žᴇʟᴇᴢᴏ, ᴢʟᴀᴛᴏ, ᴅɪᴀ, ᴋʟíč)"

on load:
    wait 2 seconds
    cacheEntities()
    if {clicker::type_str} is not set:
        set {clicker::type_str} to "skeleton"
