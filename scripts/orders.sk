options:
    prefix: &6&lᴢᴀᴋáᴢᴋʏ &8»&f
    currency: ᴍᴏɴᴇʏ

function toSmallCaps(t: text) :: text:
    set {_t} to lowercase {_t}
    replace all "a" with "ᴀ" in {_t}
    replace all "b" with "ʙ" in {_t}
    replace all "c" with "ᴄ" in {_t}
    replace all "d" with "ᴅ" in {_t}
    replace all "e" with "ᴇ" in {_t}
    replace all "f" with "ꜰ" in {_t}
    replace all "g" with "ɢ" in {_t}
    replace all "h" with "ʜ" in {_t}
    replace all "i" with "ɪ" in {_t}
    replace all "j" with "ᴊ" in {_t}
    replace all "k" with "ᴋ" in {_t}
    replace all "l" with "ʟ" in {_t}
    replace all "m" with "ᴍ" in {_t}
    replace all "n" with "ɴ" in {_t}
    replace all "o" with "ᴏ" in {_t}
    replace all "p" with "ᴘ" in {_t}
    replace all "q" with "ǫ" in {_t}
    replace all "r" with "ʀ" in {_t}
    replace all "s" with "ꜱ" in {_t}
    replace all "t" with "ᴛ" in {_t}
    replace all "u" with "ᴜ" in {_t}
    replace all "v" with "ᴠ" in {_t}
    replace all "w" with "ᴡ" in {_t}
    replace all "y" with "ʏ" in {_t}
    replace all "z" with "ᴢ" in {_t}
    return {_t}

on script load:
    send "{@prefix} ꜱʏꜱᴛéᴍ ɴᴀᴄᴛᴇɴ!" to console

every 1 hour:
    loop {orders::list::*}:
        set {_ts} to {orders::list::%loop-index%::timestamp}
        if difference between {_ts} and now > 7 days:
            set {_buyer} to {orders::list::%loop-index%::buyer}
            set {_price} to {orders::list::%loop-index%::price}
            set {_buyer_p} to {_buyer} parsed as offline player
            add {_price} to balance of {_buyer_p}
            delete {orders::list::%loop-index%::*}
            delete {orders::list::%loop-index%}

command /orders [<text>]:
    aliases: /zakazky, /order
    trigger:
        openMarketplace(player, 0)

function openMarketplace(p: player, page: number):
    set {_uuid} to uuid of {_p}
    open chest with 6 rows named "ᴛʀžɪšᴛě ᴢᴀᴋáᴢᴇᴋ" to {_p}
    set metadata tag "orders_page" of {_p} to {_page}

    # Background
    loop 54 times:
        set slot (loop-number - 1) of {_p}'s current inventory to gray stained glass pane named " "

    # Items
    set {_start} to {_page} * 45
    set {_count} to 0
    set {_slot} to 0

    loop {orders::list::*}:
        if {_count} >= {_start}:
            if {_slot} < 45:
                set {_id} to loop-index
                set {_item} to {orders::list::%{_id}%::item}
                set {_amt} to {orders::list::%{_id}%::amount}
                set {_price} to {orders::list::%{_id}%::price}
                set {_buyer_name} to {orders::list::%{_id}%::buyer_name}

                set {_lore} to "&7&lɪɴꜰᴏʀᴍᴀᴄᴇ:%nl%&8» &fᴋᴜᴘᴜᴊíᴄí: &e%{_buyer_name}%%nl%&8» &fᴘᴏʟᴏžᴋᴀ: &e%toSmallCaps("%type of {_item}%")%%nl%&8» &fᴍɴᴏžꜱᴛᴠí: &e%{_amt}%%nl%&8» &fᴄᴇɴᴀ ᴢᴀ ᴋᴜꜱ: &e%{_price} / {_amt}% {@currency}%nl%&8» &fᴄᴇʟᴋᴏᴠá ᴄᴇɴᴀ: &e%{_price}% {@currency}%nl%%nl%&e&lᴄʟɪᴄᴋ &8» &fᴘʟɴɪᴛ ᴢᴀᴋáᴢᴋᴜ"

                set slot {_slot} of {_p}'s current inventory to {_item} with lore {_lore}
                set metadata tag "order_id_%{_slot}%" of {_p} to {_id}
                add 1 to {_slot}
        add 1 to {_count}
        if {_slot} >= 45:
            stop loop

    # Pagination
    if {_page} > 0:
        set slot 45 of {_p}'s current inventory to arrow named "&eᴘředᴄʜᴏᴢí ꜱᴛʀáɴᴋᴀ"

    if size of {orders::list::*} > ({_page} + 1) * 45:
        set slot 53 of {_p}'s current inventory to arrow named "&eᴅᴀʟší ꜱᴛʀáɴᴋᴀ"

    # Action Buttons
    set slot 49 of {_p}'s current inventory to emerald block named "&a&lᴠʏᴛᴠᴏřɪᴛ ᴢᴀᴋáᴢᴋᴜ" with lore "&7&lɪɴꜰᴏʀᴍᴀᴄᴇ:%nl%&8» &fᴋʟɪᴋɴɪ ᴘʀᴏ ᴠʏᴛᴠᴏřᴇɴí%nl%&8» &fɴᴏᴠé ᴘᴏᴘᴛáᴠᴋʏ"
    set slot 50 of {_p}'s current inventory to chest named "&6&lᴍᴏᴊᴇ ᴢáꜱᴏʙʏ" with lore "&7&lɪɴꜰᴏʀᴍᴀᴄᴇ:%nl%&8» &fᴢᴅᴇ ɴᴀᴊᴅᴇš ꜱᴠᴏᴊᴇ%nl%&8» &fᴅᴏᴅᴀɴé ᴘᴏʟᴏžᴋʏ"
    set slot 48 of {_p}'s current inventory to book named "&b&lᴍᴏᴊᴇ ᴢᴀᴋáᴢᴋʏ" with lore "&7&lɪɴꜰᴏʀᴍᴀᴄᴇ:%nl%&8» &fꜱᴘʀáᴠᴀ ᴛᴠʏᴄʜ%nl%&8» &fᴀᴋᴛɪᴠɴíᴄʜ ᴢᴀᴋáᴢᴇᴋ"

on inventory click:
    if name of player's current inventory is "ᴛʀžɪšᴛě ᴢᴀᴋáᴢᴇᴋ":
        cancel event
        if clicked slot is 45:
            if metadata tag "orders_page" of player > 0:
                openMarketplace(player, (metadata tag "orders_page" of player - 1))
        else if clicked slot is 53:
            if size of {orders::list::*} > (metadata tag "orders_page" of player + 1) * 45:
                openMarketplace(player, (metadata tag "orders_page" of player + 1))
        else if clicked slot is 49:
            createOrderStep1(player)
        else if clicked slot is 50:
            openStash(player)
        else if clicked slot is 48:
            openMyOrders(player)
        else if clicked slot < 45:
            set {_id} to metadata tag "order_id_%clicked slot%" of player
            if {_id} is set:
                fillOrder(player, {_id})

function fillOrder(p: player, id: text):
    if {orders::list::%{_id}%} is not set:
        send "{@prefix} &cᴛᴀᴛᴏ ᴢᴀᴋáᴢᴋᴀ ᴊɪž ɴᴇᴇxɪꜱᴛᴜᴊᴇ!" to {_p}
        openMarketplace({_p}, 0)
        stop

    set {_buyer} to {orders::list::%{_id}%::buyer}
    if {_buyer} is uuid of {_p}:
        send "{@prefix} &cɴᴇᴍůžᴇš ᴘʟɴɪᴛ ᴠʟᴀꜱᴛɴí ᴢᴀᴋáᴢᴋᴜ!" to {_p}
        stop

    set {_item} to {orders::list::%{_id}%::item}
    set {_amt} to {orders::list::%{_id}%::amount}
    set {_price} to {orders::list::%{_id}%::price}

    open hopper named "ᴅᴏʀᴜčᴇɴí ᴘᴏʟᴏžᴇᴋ" to {_p}
    set slot 2 of {_p}'s current inventory to {_item} with lore "&7&lᴘᴏᴛřᴇʙᴜᴊᴇᴍᴇ:%nl%&8» &fᴍɴᴏžꜱᴛᴠí: &e%{_amt}%%nl%&8» &fᴏᴅᴍěɴᴀ: &e%{_price}% {@currency}%nl%%nl%&e&lᴄʟɪᴄᴋ &8» &fᴅᴏᴅᴀᴛ ᴘředᴍěᴛʏ ᴢ ɪɴᴠᴇɴᴛářᴇ"
    set metadata tag "filling_order_id" of {_p} to {_id}

on inventory click:
    if name of player's current inventory is "ᴅᴏʀᴜčᴇɴí ᴘᴏʟᴏžᴇᴋ":
        cancel event
        if clicked slot is 2:
            set {_id} to metadata tag "filling_order_id" of player
            if {orders::list::%{_id}%} is not set:
                send "{@prefix} &cᴛᴀᴛᴏ ᴢᴀᴋáᴢᴋᴀ ᴊɪž ɴᴇᴇxɪꜱᴛᴜᴊᴇ!" to player
                close player's inventory
                stop

            set {_item} to {orders::list::%{_id}%::item}
            set {_amt} to {orders::list::%{_id}%::amount}
            set {_price} to {orders::list::%{_id}%::price}
            set {_buyer} to {orders::list::%{_id}%::buyer}

            if player has {_amt} of {_item}:
                remove {_amt} of {_item} from player's inventory
                add {_price} to player's balance
                add {_amt} of {_item} to {orders::stash::%{_buyer}%::*}

                send "{@prefix} &aᴢᴀᴋáᴢᴋᴀ ꜱᴘʟɴěɴᴀ! ᴅᴏꜱᴛᴀʟ ᴊꜱɪ &e%{_price}% {@currency}&a." to player

                set {_buyer_p} to {_buyer} parsed as offline player
                if {_buyer_p} is online:
                    send "{@prefix} &aᴠᴀšᴇ ᴢᴀᴋáᴢᴋᴀ ɴᴀ &e%toSmallCaps("%type of {_item}%")% &aʙʏʟᴀ ꜱᴘʟɴěɴᴀ!" to {_buyer_p}

                delete {orders::list::%{_id}%::*}
                delete {orders::list::%{_id}%}
                close player's inventory
            else:
                send "{@prefix} &cɴᴇᴍáš ᴅᴏꜱᴛᴀᴛᴇᴋ ᴘᴏʟᴏžᴇᴋ ᴠ ɪɴᴠᴇɴᴛářɪ!" to player

function createOrderStep1(p: player):
    if tool of {_p} is air:
        send "{@prefix} &cᴍᴜꜱíš ᴅʀžᴇᴛ ᴘředᴍěᴛ, ᴋᴛᴇʀý ᴄʜᴄᴇš ᴋᴏᴜᴘɪᴛ!" to {_p}
        stop

    set {_uuid} to uuid of {_p}
    set {temp::order::%{_uuid}%::item} to 1 of tool of {_p}
    set {temp::order::%{_uuid}%::amount} to 1
    set {temp::order::%{_uuid}%::price} to 100
    createOrderStep2({_p})

function createOrderStep2(p: player):
    set {_uuid} to uuid of {_p}
    set {_item} to {temp::order::%{_uuid}%::item}
    set {_amt} to {temp::order::%{_uuid}%::amount}
    set {_price} to {temp::order::%{_uuid}%::price}

    open chest with 3 rows named "ᴠʏᴛᴠᴏřᴇɴí ᴢᴀᴋáᴢᴋʏ" to {_p}
    loop 27 times:
        set slot (loop-number - 1) of {_p}'s current inventory to gray stained glass pane named " "

    set slot 13 of {_p}'s current inventory to {_item} with lore "&7&lɪɴꜰᴏʀᴍᴀᴄᴇ:%nl%&8» &fᴘᴏʟᴏžᴋᴀ: &e%toSmallCaps("%type of {_item}%")%%nl%&8» &fᴍɴᴏžꜱᴛᴠí: &e%{_amt}%%nl%&8» &fᴄᴇʟᴋᴏᴠá ᴄᴇɴᴀ: &e%{_price}% {@currency}%nl%%nl%&e&lᴄʟɪᴄᴋ &8» &fᴘᴏᴛᴠʀᴅɪᴛ ᴀ ᴠʏᴛᴠᴏřɪᴛ"

    set slot 10 of {_p}'s current inventory to red wool named "&c-64"
    set slot 11 of {_p}'s current inventory to pink wool named "&c-1"
    set slot 15 of {_p}'s current inventory to light green wool named "&a+1"
    set slot 16 of {_p}'s current inventory to lime wool named "&a+64"

    set slot 19 of {_p}'s current inventory to red terracotta named "&c-100 {@currency}"
    set slot 20 of {_p}'s current inventory to orange terracotta named "&c-10 {@currency}"
    set slot 24 of {_p}'s current inventory to yellow terracotta named "&a+10 {@currency}"
    set slot 25 of {_p}'s current inventory to lime terracotta named "&a+100 {@currency}"

on inventory click:
    if name of player's current inventory is "ᴠʏᴛᴠᴏřᴇɴí ᴢᴀᴋáᴢᴋʏ":
        cancel event
        set {_uuid} to uuid of player
        if clicked slot is 13:
            if player's balance < {temp::order::%{_uuid}%::price}:
                send "{@prefix} &cɴᴇᴍáš ᴅᴏꜱᴛᴀᴛᴇᴋ ᴘᴇɴěᴢ!" to player
                stop

            remove {temp::order::%{_uuid}%::price} from player's balance

            set {_id} to "%random integer between 100000 and 999999%"
            while {orders::list::%{_id}%} is set:
                set {_id} to "%random integer between 100000 and 999999%"

            set {orders::list::%{_id}%} to true
            set {orders::list::%{_id}%::item} to {temp::order::%{_uuid}%::item}
            set {orders::list::%{_id}%::amount} to {temp::order::%{_uuid}%::amount}
            set {orders::list::%{_id}%::price} to {temp::order::%{_uuid}%::price}
            set {orders::list::%{_id}%::buyer} to {_uuid}
            set {orders::list::%{_id}%::buyer_name} to name of player
            set {orders::list::%{_id}%::timestamp} to now

            send "{@prefix} &aᴢᴀᴋáᴢᴋᴀ ʙʏʟᴀ ᴠʏᴛᴠᴏřᴇɴᴀ!" to player
            delete {temp::order::%{_uuid}%::*}
            close player's inventory

        else if clicked slot is 10:
            if {temp::order::%{_uuid}%::amount} > 64:
                remove 64 from {temp::order::%{_uuid}%::amount}
                createOrderStep2(player)
        else if clicked slot is 11:
            if {temp::order::%{_uuid}%::amount} > 1:
                remove 1 from {temp::order::%{_uuid}%::amount}
                createOrderStep2(player)
        else if clicked slot is 15:
            add 1 to {temp::order::%{_uuid}%::amount}
            createOrderStep2(player)
        else if clicked slot is 16:
            add 64 to {temp::order::%{_uuid}%::amount}
            createOrderStep2(player)
        else if clicked slot is 19:
            if {temp::order::%{_uuid}%::price} > 100:
                remove 100 from {temp::order::%{_uuid}%::price}
                createOrderStep2(player)
        else if clicked slot is 20:
            if {temp::order::%{_uuid}%::price} > 10:
                remove 10 from {temp::order::%{_uuid}%::price}
                createOrderStep2(player)
        else if clicked slot is 24:
            add 10 to {temp::order::%{_uuid}%::price}
            createOrderStep2(player)
        else if clicked slot is 25:
            add 100 to {temp::order::%{_uuid}%::price}
            createOrderStep2(player)

function openMyOrders(p: player):
    set {_uuid} to uuid of {_p}
    open chest with 6 rows named "ᴍᴏᴊᴇ ᴢᴀᴋáᴢᴋʏ" to {_p}
    loop 54 times:
        set slot (loop-number - 1) of {_p}'s current inventory to gray stained glass pane named " "

    set {_slot} to 0
    loop {orders::list::*}:
        if {orders::list::%loop-index%::buyer} is {_uuid}:
            set {_id} to loop-index
            set {_item} to {orders::list::%{_id}%::item}
            set {_amt} to {orders::list::%{_id}%::amount}
            set {_price} to {orders::list::%{_id}%::price}

            set {_lore} to "&7&lɪɴꜰᴏʀᴍᴀᴄᴇ:%nl%&8» &fᴘᴏʟᴏžᴋᴀ: &e%toSmallCaps("%type of {_item}%")%%nl%&8» &fᴍɴᴏžꜱᴛᴠí: &e%{_amt}%%nl%&8» &fᴄᴇʟᴋᴏᴠá ᴄᴇɴᴀ: &e%{_price}% {@currency}%nl%%nl%&c&lᴄʟɪᴄᴋ &8» &fᴢʀᴜšɪᴛ ᴢᴀᴋáᴢᴋᴜ"

            set slot {_slot} of {_p}'s current inventory to {_item} with lore {_lore}
            set metadata tag "my_order_id_%{_slot}%" of {_p} to {_id}
            add 1 to {_slot}
            if {_slot} >= 45:
                stop loop

    set slot 49 of {_p}'s current inventory to arrow named "&eᴢᴘěᴛ"

on inventory click:
    if name of player's current inventory is "ᴍᴏᴊᴇ ᴢᴀᴋáᴢᴋʏ":
        cancel event
        if clicked slot is 49:
            openMarketplace(player, 0)
        else if clicked slot < 45:
            set {_id} to metadata tag "my_order_id_%clicked slot%" of player
            if {_id} is set:
                if {orders::list::%{_id}%} is not set:
                    send "{@prefix} &cᴛᴀᴛᴏ ᴢᴀᴋáᴢᴋᴀ ᴊɪž ɴᴇᴇxɪꜱᴛᴜᴊᴇ!" to player
                    openMyOrders(player)
                    stop
                add {orders::list::%{_id}%::price} to player's balance
                delete {orders::list::%{_id}%::*}
                delete {orders::list::%{_id}%}
                send "{@prefix} &cᴢᴀᴋáᴢᴋᴀ ᴢʀᴜšᴇɴᴀ, ᴘᴇɴíᴢᴇ ᴠʀáᴄᴇɴʏ." to player
                openMyOrders(player)

function openStash(p: player):
    set {_uuid} to uuid of {_p}
    open chest with 6 rows named "ᴍᴏᴊᴇ ᴢáꜱᴏʙʏ" to {_p}
    loop 54 times:
        set slot (loop-number - 1) of {_p}'s current inventory to gray stained glass pane named " "

    set {_slot} to 0
    loop {orders::stash::%{_uuid}%::*}:
        set {_item} to loop-value
        set slot {_slot} of {_p}'s current inventory to {_item} with lore "&e&lᴄʟɪᴄᴋ &8» &fᴠʏʙʀᴀᴛ ᴘředᴍěᴛ"
        set metadata tag "stash_index_%{_slot}%" of {_p} to loop-index
        add 1 to {_slot}
        if {_slot} >= 45:
            stop loop

    set slot 49 of {_p}'s current inventory to arrow named "&eᴢᴘěᴛ"
    set slot 50 of {_p}'s current inventory to hopper named "&a&lᴠʏʙʀᴀᴛ ᴠšᴇ"

on inventory click:
    if name of player's current inventory is "ᴍᴏᴊᴇ ᴢáꜱᴏʙʏ":
        cancel event
        set {_uuid} to uuid of player
        if clicked slot is 49:
            openMarketplace(player, 0)
        else if clicked slot is 50:
            loop {orders::stash::%{_uuid}%::*}:
                if player has enough space for loop-value:
                    give loop-value to player
                    delete {orders::stash::%{_uuid}%::%loop-index%}
                else:
                    send "{@prefix} &cɪɴᴠᴇɴᴛář ꜱᴇ ɴᴀᴘʟɴɪʟ! ɴᴇᴋᴛᴇʀé ᴘᴏʟᴏžᴋʏ ᴢůꜱᴛᴀʟʏ." to player
                    stop loop
            openStash(player)
        else if clicked slot < 45:
            set {_index} to metadata tag "stash_index_%clicked slot%" of player
            if {_index} is set:
                set {_item} to {orders::stash::%{_uuid}%::%{_index}%}
                if player has enough space for {_item}:
                    give {_item} to player
                    delete {orders::stash::%{_uuid}%::%{_index}%}
                    openStash(player)
                else:
                    send "{@prefix} &cᴘʟɴý ɪɴᴠᴇɴᴛář!" to player
