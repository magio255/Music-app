options:
    prefix: &bᴛᴘᴀ &8» &7
    error: &cᴛᴘᴀ &8» &7
    color: &b
    time: 60 seconds
    delay: 3 seconds

# Variables:
# {tpa::request::%uuid of player%} - stores the player who sent the request
# {tpa::type::%uuid of player%} - "to" or "here"
# {tpa::time::%uuid of player%} - stores the timestamp of the request
# {tpaoff::%uuid of player%} - boolean

command /tpa [<player>]:
    trigger:
        if arg 1 is not set:
            send "{@error}ᴘᴏᴜžɪᴛí: /ᴛᴘᴀ <ʜʀáč>"
            stop
        if arg 1 is player:
            send "{@error}ɴᴇᴍůžᴇš sᴇ ᴛᴇʟᴇᴘᴏʀᴛᴏᴠᴀᴛ sáᴍ ᴋ sᴇʙě!"
            stop
        if {tpaoff::%uuid of arg 1%} is set:
            send "{@error}ʜʀáč ᴍá ᴠʏᴘɴᴜᴛé žáᴅᴏsᴛɪ ᴏ ᴛᴇʟᴇᴘᴏʀᴛ."
            stop
        set {_waited} to difference between {tpa::cooldown::%uuid of player%} and now
        if {_waited} is less than 5 seconds:
            set {_remaining} to 5 seconds
            remove {_waited} from {_remaining}
            send "{@error}ᴍᴜsíš ᴘᴏčᴋᴀᴛ ᴊᴇšᴛě %{_remaining}% ᴘřᴇᴅ ᴅᴀʟší žáᴅᴏsᴛí."
            stop
        if {tpa::sent::%uuid of player%} is set:
            send "{@error}ᴜž ᴍáš ᴀᴋᴛɪᴠɴí žáᴅᴏsᴛ ᴏ ᴛᴇʟᴇᴘᴏʀᴛ. ᴢʀᴜš ᴊɪ ᴘᴏᴍᴏᴄí /ᴛᴘᴀᴄᴀɴᴄᴇʟ."
            stop
        set {tpa::request::%uuid of arg 1%} to player
        set {tpa::sent::%uuid of player%} to arg 1
        set {tpa::cooldown::%uuid of player%} to now
        set {tpa::type::%uuid of arg 1%} to "to"
        set {_now} to now
        set {tpa::time::%uuid of arg 1%} to {_now}
        send "{@prefix}ᴢᴀsʟᴀʟ ᴊsɪ žáᴅᴏsᴛ ᴏ ᴛᴇʟᴇᴘᴏʀᴛ ʜʀáčɪ {@color}%arg 1%&7."
        send "{@prefix}ʜʀáč {@color}%player% &7sᴇ ᴄʜᴄᴇ ᴛᴇʟᴇᴘᴏʀᴛᴏᴠᴀᴛ ᴋ ᴛᴏʙě." to arg 1
        send formatted "{@prefix}<tooltip:&aᴋʟɪᴋɴɪ ᴘʀᴏ ᴘᴏᴛᴠʀᴢᴇɴí><command:/tpaccept>&a&l[ᴘᴏᴛᴠʀᴅɪᴛ]<reset> &7&l/ <tooltip:&cᴋʟɪᴋɴɪ ᴘʀᴏ ᴏᴅᴍíᴛɴᴜᴛí><command:/tpadeny>&c&l[ᴏᴅᴍɪᴛɴᴏᴜᴛ]" to arg 1
        wait {@time}
        if {tpa::request::%uuid of arg 1%} is player:
            if {tpa::time::%uuid of arg 1%} is {_now}:
                delete {tpa::request::%uuid of arg 1%}
                delete {tpa::sent::%uuid of player%}
                delete {tpa::type::%uuid of arg 1%}
                delete {tpa::time::%uuid of arg 1%}
                send "{@prefix}žáᴅᴏsᴛ ᴏ ᴛᴇʟᴇᴘᴏʀᴛ ᴘʀᴏ {@color}%arg 1% &7ᴠʏᴘʀšᴇʟᴀ."

command /tpahere [<player>]:
    trigger:
        if arg 1 is not set:
            send "{@error}ᴘᴏᴜžɪᴛí: /ᴛᴘᴀʜᴇʀᴇ <ʜʀáč>"
            stop
        if arg 1 is player:
            send "{@error}ɴᴇᴍůžᴇš sᴇ ᴛᴇʟᴇᴘᴏʀᴛᴏᴠᴀᴛ sáᴍ ᴋ sᴇʙě!"
            stop
        if {tpaoff::%uuid of arg 1%} is set:
            send "{@error}ʜʀáč ᴍá ᴠʏᴘɴᴜᴛé žáᴅᴏsᴛɪ ᴏ ᴛᴇʟᴇᴘᴏʀᴛ."
            stop
        set {_waited} to difference between {tpa::cooldown::%uuid of player%} and now
        if {_waited} is less than 5 seconds:
            set {_remaining} to 5 seconds
            remove {_waited} from {_remaining}
            send "{@error}ᴍᴜsíš ᴘᴏčᴋᴀᴛ ᴊᴇšᴛě %{_remaining}% ᴘřᴇᴅ ᴅᴀʟší žáᴅᴏsᴛí."
            stop
        if {tpa::sent::%uuid of player%} is set:
            send "{@error}ᴜž ᴍáš ᴀᴋᴛɪᴠɴí žáᴅᴏsᴛ ᴏ ᴛᴇʟᴇᴘᴏʀᴛ. ᴢʀᴜš ᴊɪ ᴘᴏᴍᴏᴄí /ᴛᴘᴀᴄᴀɴᴄᴇʟ."
            stop
        set {tpa::request::%uuid of arg 1%} to player
        set {tpa::sent::%uuid of player%} to arg 1
        set {tpa::cooldown::%uuid of player%} to now
        set {tpa::type::%uuid of arg 1%} to "here"
        set {_now} to now
        set {tpa::time::%uuid of arg 1%} to {_now}
        send "{@prefix}ᴢᴀsʟᴀʟ ᴊsɪ žáᴅᴏsᴛ ᴏ ᴛᴇʟᴇᴘᴏʀᴛ ᴋ sᴇʙě ʜʀáčɪ {@color}%arg 1%&7."
        send "{@prefix}ʜʀáč {@color}%player% &7ᴄʜᴄᴇ, ᴀʙʏs sᴇ ᴛᴇʟᴇᴘᴏʀᴛᴏᴠᴀʟ ᴋ ɴěᴍᴜ." to arg 1
        send formatted "{@prefix}<tooltip:&aᴋʟɪᴋɴɪ ᴘʀᴏ ᴘᴏᴛᴠʀᴢᴇɴí><command:/tpaccept>&a&l[ᴘᴏᴛᴠʀᴅɪᴛ]<reset> &7&l/ <tooltip:&cᴋʟɪᴋɴɪ ᴘʀᴏ ᴏᴅᴍíᴛɴᴜᴛí><command:/tpadeny>&c&l[ᴏᴅᴍɪᴛɴᴏᴜᴛ]" to arg 1
        wait {@time}
        if {tpa::request::%uuid of arg 1%} is player:
            if {tpa::time::%uuid of arg 1%} is {_now}:
                delete {tpa::request::%uuid of arg 1%}
                delete {tpa::sent::%uuid of player%}
                delete {tpa::type::%uuid of arg 1%}
                delete {tpa::time::%uuid of arg 1%}
                send "{@prefix}žáᴅᴏsᴛ ᴏ ᴛᴇʟᴇᴘᴏʀᴛ ᴘʀᴏ {@color}%arg 1% &7ᴠʏᴘʀšᴇʟᴀ."

command /tpacancel:
    trigger:
        if {tpa::sent::%uuid of player%} is set:
            set {_target} to {tpa::sent::%uuid of player%}
            delete {tpa::request::%uuid of {_target}%}
            delete {tpa::sent::%uuid of player%}
            delete {tpa::type::%uuid of {_target}%}
            delete {tpa::time::%uuid of {_target}%}
            send "{@prefix}ᴢʀᴜšɪʟ ᴊsɪ žáᴅᴏsᴛ ᴘʀᴏ {@color}%{_target}%&7."
        else:
            send "{@error}ɴᴇᴍáš žáᴅɴᴏᴜ ᴏᴅᴇsʟᴀɴᴏᴜ žáᴅᴏsᴛ."

command /tpaoff:
    trigger:
        if {tpaoff::%uuid of player%} is not set:
            set {tpaoff::%uuid of player%} to true
            send "{@prefix}žáᴅᴏsᴛɪ ᴏ ᴛᴇʟᴇᴘᴏʀᴛ ʙʏʟʏ &ᴄᴠʏᴘɴᴜᴛʏ."
        else:
            delete {tpaoff::%uuid of player%}
            send "{@prefix}žáᴅᴏsᴛɪ ᴏ ᴛᴇʟᴇᴘᴏʀᴛ ʙʏʟʏ &ᴀᴢᴀᴘɴᴜᴛʏ."

command /tpaccept:
    aliases: tpaaccept
    trigger:
        if {tpa::request::%uuid of player%} is not set:
            send "{@error}ɴᴇᴍáš žáᴅɴᴏᴜ ᴀᴋᴛɪᴠɴí žáᴅᴏsᴛ ᴏ ᴛᴇʟᴇᴘᴏʀᴛ."
            stop
        set {_target} to {tpa::request::%uuid of player%}
        set {_type} to {tpa::type::%uuid of player%}
        delete {tpa::request::%uuid of player%}
        delete {tpa::sent::%uuid of {_target}%}
        delete {tpa::type::%uuid of player%}
        delete {tpa::time::%uuid of player%}

        send "{@prefix}ᴘʀɪᴊᴀʟ ᴊsɪ žáᴅᴏsᴛ. ᴛᴇʟᴇᴘᴏʀᴛᴀᴄᴇ ᴢᴀ {@delay}..."
        send "{@prefix}ʜʀáč {@color}%player% &7ᴘʀɪᴊᴀʟ ᴛᴠᴏᴊí žáᴅᴏsᴛ. ᴛᴇʟᴇᴘᴏʀᴛᴀᴄᴇ ᴢᴀ {@delay}..." to {_target}

        if {_type} is "to":
            set {_loc} to location of {_target}
            set {_p} to {_target}
        else:
            set {_loc} to location of player
            set {_p} to player

        loop 3 times:
            wait 1 second
            if {_p} is not online:
                if {_p} is not player:
                    send "{@error}ᴛᴇʟᴇᴘᴏʀᴛᴀᴄᴇ ᴢʀᴜšᴇɴᴀ! ʜʀáč sᴇ ᴏᴅᴘᴏᴊɪʟ." to player
                else:
                    send "{@error}ᴛᴇʟᴇᴘᴏʀᴛᴀᴄᴇ ᴢʀᴜšᴇɴᴀ! ʜʀáč sᴇ ᴏᴅᴘᴏᴊɪʟ." to {_target}
                stop
            set {_other} to player
            if {_p} is player:
                set {_other} to {_target}
            if {_other} is not online:
                send "{@error}ᴛᴇʟᴇᴘᴏʀᴛᴀᴄᴇ ᴢʀᴜšᴇɴᴀ! ʜʀáč sᴇ ᴏᴅᴘᴏᴊɪʟ." to {_p}
                stop
            if distance between {_p} and {_loc} > 0.5:
                send "{@error}ᴛᴇʟᴇᴘᴏʀᴛᴀᴄᴇ ᴢʀᴜšᴇɴᴀ! ᴘᴏʜɴᴜʟ ᴊsɪ sᴇ." to {_p}
                send "{@error}ᴛᴇʟᴇᴘᴏʀᴛᴀᴄᴇ ᴢʀᴜšᴇɴᴀ! ʜʀáč sᴇ ᴘᴏʜɴᴜʟ." to {_other}
                stop

        if {_other} is online:
            execute console command "/minecraft:tp %{_p}% %{_other}%"
            send "{@prefix}ʙʏʟ ᴊsɪ ᴛᴇʟᴇᴘᴏʀᴛᴏᴠáɴ." to {_p}
        else:
            send "{@error}ʜʀáč ᴊɪž ɴᴇɴí ᴘřɪᴘᴏᴊᴇɴ." to {_p}

command /tpadeny:
    aliases: tpdeny, tpa-deny
    trigger:
        if {tpa::request::%uuid of player%} is not set:
            send "{@error}ɴᴇᴍáš žáᴅɴᴏᴜ ᴀᴋᴛɪᴠɴí žáᴅᴏsᴛ ᴏ ᴛᴇʟᴇᴘᴏʀᴛ."
            stop
        set {_target} to {tpa::request::%uuid of player%}
        delete {tpa::request::%uuid of player%}
        delete {tpa::sent::%uuid of {_target}%}
        delete {tpa::type::%uuid of player%}
        delete {tpa::time::%uuid of player%}
        send "{@prefix}ᴏᴅᴍíᴛʟ ᴊsɪ žáᴅᴏsᴛ."
        send "{@prefix}ʜʀáč {@color}%player% &7ᴏᴅᴍíᴛʟ ᴛᴠᴏᴊí žáᴅᴏsᴛ ᴏ ᴛᴇʟᴇᴘᴏʀᴛ." to {_target}

on quit:
    if {tpa::sent::%uuid of player%} is set:
        set {_target} to {tpa::sent::%uuid of player%}
        delete {tpa::request::%uuid of {_target}%}
        delete {tpa::type::%uuid of {_target}%}
        delete {tpa::time::%uuid of {_target}%}
        delete {tpa::sent::%uuid of player%}
    if {tpa::request::%uuid of player%} is set:
        set {_requester} to {tpa::request::%uuid of player%}
        delete {tpa::sent::%uuid of {_requester}%}
        delete {tpa::request::%uuid of player%}
        delete {tpa::type::%uuid of player%}
        delete {tpa::time::%uuid of player%}
